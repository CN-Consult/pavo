{
  "name": "pavo",
  "version": "1.0.0",
  "description": "An electron based dashboard app that allows to show multiple websites on a big screen tv easily",
  "homepage": "https://github.com/CN-Consult/pavo",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "generate-docs": "node_modules/.bin/jsdoc -c jsdoc.json"
  },
  "build": {
    "appId": "pavo",
    "files": [
      "**/*",
      "!**/config/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility"
    }
  },
  "author": {
    "name": "Yannick Lapp",
    "email": "yannick.lapp@cn-consult.eu"
  },
  "license": "MIT",
  "devDependencies": {
    "docdash": "^1.0.2",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "jsdoc": "^3.5.5",
    "node": "^20.18.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^5.7.1",
    "@json-editor/json-editor": "^1.3.3",
    "bootstrap": "^5.3.3",
    "bufferutil": "^4.0.7",
    "chokidar": "^3.5.3",
    "express": "^5.0.1",
    "express-minify-html": "^0.12.0",
    "glob": "^11.0.0",
    "jquery": "^3.7.1",
    "jquery-ui-dist": "^1.13.3",
    "log4js": "^6.9.1",
    "mv": "^2.1.1",
    "native-toast": "^2.0.0",
    "nunjucks": "^3.2.4",
    "object-equals": "^0.3.0",
    "popper.js": "^1.16.1",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "textfit": "^2.4.0",
    "utf-8-validate": "^6.0.5"
  }
}
